{
  "name": "rhea",
  "version": "1.3.2",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "!apps/backend-test-node"
    ],
    "catalog": {
      "@orpc/client": "^1.15.1",
      "@orpc/contract": "^1.15.1",
      "@orpc/openapi": "^1.15.1",
      "@orpc/openapi-client": "^1.15.1",
      "@orpc/server": "^1.15.1",
      "@types/node": "^26.6.2",
      "typescript": "^7.0.2",
      "wrangler": "^4.137.0",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "lint-fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3"
  },
  "trustedDependencies": []
}
