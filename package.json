{
  "name": "rhea",
  "version": "1.3.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "lint-fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3"
  },
  "trustedDependencies": []
}
