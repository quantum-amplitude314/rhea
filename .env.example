# Copy to .env.local (not committed). Next inlines NEXT_PUBLIC_* at build time:
# restart `bun run dev` or rebuild after a change.

# Turnstile site key. Real key from the Cloudflare dashboard; pairs with the real
# TURNSTILE_SECRET_KEY in the API:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<real-site-key>
# Test key, always passes; pairs with the API's 1x test secret:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Test key, always fails, widget visible:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
# Test key, forces an interactive challenge, widget visible:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF

# API origin for `bun run dev`; defaults to http://127.0.0.1:3001:
# API_URL=http://127.0.0.1:3001
